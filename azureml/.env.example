# Azure ML workspace/driver config for azureml/cli.py + azureml/submit_pipeline.py.
# Copy to azureml/.env and fill in -- azureml/.env is gitignored (see repo .gitignore),
# same pattern as the root .env for the Flask app.

AZUREML_SIM_SUBSCRIPTION_ID=
AZUREML_SIM_RESOURCE_GROUP=
AZUREML_SIM_WORKSPACE=
AZUREML_SIM_COMPUTE=sim-cluster
AZUREML_SIM_ENVIRONMENT=azureml:openlineage-job-simulator:4
AZUREML_SIM_USE_SERVERLESS_INIT=true

# Recommended: resolve DD_API_KEY from the workspace's Key Vault at submission
# time instead of a plaintext value (see azureml/README.md step 3).
AZUREML_SIM_KEYVAULT_URL=
AZUREML_SIM_DD_API_KEY_SECRET=DD-API-KEY

# Fallback: if AZUREML_SIM_KEYVAULT_URL is left blank, DD_API_KEY is read
# directly from here instead -- convenient for local iteration, but prefer
# Key Vault so the key never has to live in a file you could accidentally commit.
DD_API_KEY=

# Same knobs as the root .env.example (all optional, shown with defaults):
DD_SITE=datadoghq.com
DD_SERVICE=openlineage-worker-demo
DD_ENV=azureml-demo
OL_TRANSPORT=datadog
OL_NAMESPACE=demo.datadog.azureml
OL_PRODUCER=https://github.com/datadog/openlineage-do-jobs
LOG_LEVEL=INFO
